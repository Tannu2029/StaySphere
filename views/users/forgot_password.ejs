<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
  <div class="col-8 offset-2 col-md-6 offset-md-3">
    <h3 class="mb-3">Forgot Password</h3>
    <p class="text-muted">Enter your registered email address</p>
    
    <form action="/forgot_password" method="POST" class="needs-validation" novalidate>
      <div class="mb-3">
        <label for="email" class="form-label">Email Address</label>
        <input 
          name="email" 
          id="email" 
          type="email" 
          class="form-control" 
          placeholder="name@example.com" 
          required 
        />
        <div class="invalid-feedback">Please enter a valid email address</div>
      </div>
      <button type="submit" class="btn confirm-btn w-100">Confirm</button>
    </form>
  </div>
</div>